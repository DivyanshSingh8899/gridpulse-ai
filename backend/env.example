# GridPulse AI — backend environment template
# Copy to .env before running:  cp backend/env.example backend/.env
# (Or run with no file at all — defaults below are baked into server.ts.)

# ─── Server ────────────────────────────────────────────────────────────────
PORT=8000
# Allowed browser origin(s) for CORS. Comma-separate extra origins.
CORS_ORIGIN=http://localhost:5173

# ─── AWS credentials ───────────────────────────────────────────────────────
# Leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY EMPTY to run in
# deterministic-fallback mode — no AWS calls are made, and /api/inspect and
# /api/copilot return the same complete payload shapes via the byte-hash
# analyzer / structured ESG engine. When both are set, the backend makes
# real calls to Amazon Rekognition DetectLabels and Bedrock Converse
# (anthropic.claude-3-5-sonnet-20240620-v1:0).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional (future): S3 bucket for audit-image persistence
# GRIDPULSE_ASSET_BUCKET=
